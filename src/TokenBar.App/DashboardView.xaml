<UserControl
    x:Class="TokenBar.App.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Wordmark accent per theme, macOS BrandMark.swift
                     syrtisAccent: the dark teal has too little contrast on a
                     light surface and the light teal goes muddy on a dark one,
                     so each theme gets its own. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SyrtisAccentBrush" Color="#1B5E56" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SyrtisAccentBrush" Color="#56B7A6" />
                </ResourceDictionary>
                <!-- A contrast theme sets the colors itself, so the wordmark
                     takes its window text color. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush
                        x:Key="SyrtisAccentBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Mark size: macOS frames BrandMark at 17×17 (PopoverView.swift:491). -->
            <x:Double x:Key="BrandMarkSize">17</x:Double>
            <!-- Wordmark size: macOS .syrtisWordmark(size: 15) (PopoverView.swift:493). -->
            <x:Double x:Key="BrandWordmarkSize">15</x:Double>
            <!-- Gap between mark and wordmark: SwiftUI's default HStack
                 spacing, which the macOS header leaves unset. -->
            <x:Double x:Key="BrandSpacing">8</x:Double>
            <!-- Wordmark face, after macOS syrtisWordmark's Iowan Old Style →
                 Palatino → system serif. Iowan Old Style is an Apple system
                 font that may not be redistributed, so Windows starts at the
                 second choice: Palatino Linotype ships with Windows and covers
                 Greek. Georgia is the next serif if it is missing. -->
            <FontFamily x:Key="BrandWordmarkFont">Palatino Linotype, Georgia</FontFamily>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="16,14,16,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <Grid>
