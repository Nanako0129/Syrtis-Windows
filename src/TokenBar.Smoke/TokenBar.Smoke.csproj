<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TokenBar.Interop\TokenBar.Interop.csproj" />
    <!-- For the model-report step's implausible-cost probe: it must judge rows
         with the same fold and rule the Models lens uses (ModelReportFold,
         CostPlausibility, ClientRegistry), not a re-implementation of them. -->
    <ProjectReference Include="..\TokenBar.Core\TokenBar.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <TbNativePackagingEnabled>true</TbNativePackagingEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
